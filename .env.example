# =============================================================================
# crm-data-hygiene-sentinel: environment template
# Copy to .env and edit. NEVER commit the real .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# n8n instance (self-hosted)
# -----------------------------------------------------------------------------
N8N_HOST=n8n.example.com
N8N_PORT=5678
N8N_PROTOCOL=https
# Public base URL n8n uses to build webhook URLs (keep the trailing slash)
WEBHOOK_URL=https://n8n.example.com/
GENERIC_TIMEZONE=UTC
TZ=UTC

# Encrypts credentials stored by n8n. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# REQUIRED for this workflow to read SENTINEL_* / SALESFORCE_* via $env in Code nodes.
# Security trade-off: lets workflow authors on this instance read env vars. Only
# enable on instances you control. If left true, the workflow uses safe defaults.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Execution data contains PII from your payloads. Prune aggressively in production.
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# -----------------------------------------------------------------------------
# Sentinel runtime configuration (read by the "Sanitize & Score" node)
# -----------------------------------------------------------------------------
# hubspot | salesforce
SENTINEL_CRM_TARGET=hubspot

# SAFE DEFAULT: true = process and log only, never write to the CRM
SENTINEL_DRY_RUN=true

# ISO-2 country applied to phone numbers without a country code
SENTINEL_DEFAULT_COUNTRY=US

# Fields counted toward completeness (comma-separated)
SENTINEL_REQUIRED_FIELDS=email,firstname,lastname,company,phone

# Extra domains to treat as personal (comma-separated), e.g. mail.example.net
SENTINEL_EXTRA_PERSONAL_DOMAINS=

# true = write status/flags/date to custom CRM fields (create them first, see README)
SENTINEL_WRITE_HYGIENE_PROPS=false

# Scheduled sweep: how far back to look for new HubSpot contacts
SENTINEL_SWEEP_LOOKBACK_HOURS=24

# Optional Slack-compatible incoming webhook for the (disabled) notify node
SENTINEL_ALERT_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Salesforce (non-secret settings used by the workflow)
# -----------------------------------------------------------------------------
# e.g. https://yourorg.my.salesforce.com (no trailing slash). Required for Salesforce.
SALESFORCE_INSTANCE_URL=
SALESFORCE_API_VERSION=v62.0

# -----------------------------------------------------------------------------
# SECRETS: REFERENCE ONLY
# The workflow does NOT read these from the environment. Enter them in
# n8n -> Credentials (encrypted at rest). They are listed here so you can keep
# track of what to provision, or use them with your own secret manager / CI.
# -----------------------------------------------------------------------------
# Value for the Header Auth credential "Sentinel Webhook Secret"
# (header name: X-Sentinel-Secret). Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# HubSpot Private App token (scopes: crm.objects.contacts.read / .write)
HUBSPOT_ACCESS_TOKEN=

# Salesforce Connected App (OAuth2 credential in n8n; scopes: api, refresh_token)
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
